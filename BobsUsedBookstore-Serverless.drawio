        <mxCell id="7WpZ0iJpJy3THZHLrlA9-85" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Search books is available to both Guest and Authenticated users. Retrieves data from Amazon DynamoDB. Checks image availability in published Amazon S3 bucket. Refers to default image when book image is unavailable&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="7WpZ0iJpJy3THZHLrlA9-124" vertex="1">
          <mxGeometry x="70.96099378881989" y="19.05" width="627.1818633540374" height="57.14" as="geometry" />
        </mxCell>
        <mxCell id="7WpZ0iJpJy3THZHLrlA9-86" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Validates user permission with Amazon Verified Permissions (AVP). Only Authorized users can Add book, Update book and Request Pre-signed URL. Use Lambda Authorizer to authorize users&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="7WpZ0iJpJy3THZHLrlA9-124" vertex="1">
          <mxGeometry x="70.96099378881989" y="95.71" width="636.1756521739131" height="47.14" as="geometry" />
        </mxCell>
        <mxCell id="7WpZ0iJpJy3THZHLrlA9-96" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Amazon DynamoDB stores validated book information&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="7WpZ0iJpJy3THZHLrlA9-124" vertex="1">
          <mxGeometry x="70.95751575842081" y="166.99665562461746" width="506.8392122518121" height="37.61729499782319" as="geometry" />
        </mxCell>
        <mxCell id="7WpZ0iJpJy3THZHLrlA9-98" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Amazon Eventbrige rules monitor Amazon S3 upload events. Image upload events trigger image validation workflow&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="7WpZ0iJpJy3THZHLrlA9-124" vertex="1">
          <mxGeometry x="71.52310559006212" y="280.47" width="606.9683229813666" height="47.14" as="geometry" />
        </mxCell>
        <mxCell id="7WpZ0iJpJy3THZHLrlA9-100" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;AWS Step functions orchestrates image validation with Amazon Rekognition service&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="7WpZ0iJpJy3THZHLrlA9-124" vertex="1">
          <mxGeometry x="72.64732919254661" y="335.39" width="615.3775155279503" height="71.61" as="geometry" />
        </mxCell>
        <mxCell id="7WpZ0iJpJy3THZHLrlA9-102" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Amazon CloudFront servers resized safe images from published Amazon S3 bucket to frontend applications&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="7WpZ0iJpJy3THZHLrlA9-124" vertex="1">
          <mxGeometry x="72.64310559006212" y="397" width="616.5017391304349" height="60.53" as="geometry" />
        </mxCell>
        <mxCell id="7WpZ0iJpJy3THZHLrlA9-104" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Update book follows identical authorization and validation flow as Add Book&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="7WpZ0iJpJy3THZHLrlA9-124" vertex="1">
          <mxGeometry x="75.4" y="461" width="604.6" height="50.21" as="geometry" />
        </mxCell>
        <mxCell id="7WpZ0iJpJy3THZHLrlA9-107" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Request pre-signed URL of the prefix for book id to upload multiple images&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;" parent="7WpZ0iJpJy3THZHLrlA9-124" vertex="1">
